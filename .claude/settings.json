{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Write|Edit|NotebookEdit|Read|Glob|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect_data_servers.py\"",
            "shell": "bash",
            "timeout": 15,
            "statusMessage": "Checking data-server access policy"
          }
        ]
      }
    ]
  }
}
